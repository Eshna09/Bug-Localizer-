# LLM Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here

# Embedding model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG retrieval
RAG_TOP_K=5

# Storage
DATABASE_URL=sqlite:///./buglocalizer.db
WORKSPACE_DIR=./workspaces

# Ground-truth exclusion patterns (comma-separated filenames/dirs to exclude from localization)
GROUND_TRUTH_EXCLUSIONS=BUG_DATASET.md,bug_dataset.json,bug_dataset.csv,dataset,ground_truth,evaluation,corrected_patches

# Security
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=120

# Docker verification (set to false to disable)
ENABLE_DOCKER_VERIFICATION=true
DOCKER_TIMEOUT_SECONDS=120
